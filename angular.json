{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "np-clickbait": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "cb",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/renderer",
              "browser": ""
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              {
                "glob": "LICENSE.txt",
                "input": ".",
                "output": "assets/legal"
              },
              {
                "glob": "*.txt",
                "input": "LICENSES",
                "output": "assets/legal"
              },
              {
                "glob": "32x32.png",
                "input": "src-tauri/icons",
                "output": "assets/icon"
              }
            ],
            "styles": [
              "src/global.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kb",
                  "maximumError": "16kb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "outputHashing": "none",
              "sourceMap": true,
              "namedChunks": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "np-clickbait:build:production"
            },
            "development": {
              "buildTarget": "np-clickbait:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "concurrency": "auto",
            "cache": true,
            "cacheLocation": ".eslintcache",
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html",
              "*.js",
              "*.mjs"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component",
      "style": "scss",
      "changeDetection": "OnPush"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
