{
  "name": "np-debt-growth",
  "version": "1.0.0",
  "description": "Debt Growth — an idle game about a consultancy that bills to fix the mess it is paid to make.",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnSmithDoe/np-debt-growth.git"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href ./",
    "watch": "ng build --watch -c development",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "ng lint",
    "verify": "sheriff verify src/main.ts",
    "check:viewport": "node tools/viewport-check.mjs",
    "check:art": "node .claude/skills/lpc-character/scripts/catalog.mjs presets | awk '{print $1}' | xargs -I{} -n1 sh -c 'node .claude/skills/lpc-character/scripts/catalog.mjs check --preset {} >/dev/null || { echo \"FAIL {}\"; exit 255; }'",
    "typecheck": "ngc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\""
  },
  "dependencies": {
    "@angular/common": "^21.2.20",
    "@angular/compiler": "^21.2.20",
    "@angular/core": "^21.2.20",
    "@angular/platform-browser": "^21.2.20",
    "@angular/router": "^21.2.20",
    "@ngx-translate/core": "^18.0.0",
    "phaser": "^4.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.1",
    "@angular-eslint/builder": "^21.4.0",
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.20",
    "@angular/language-service": "^21.2.20",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.1",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "sass": "^1.101.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.8",
    "vitest-canvas-mock": "^1.1.4"
  }
}
